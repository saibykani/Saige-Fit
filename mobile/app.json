{
  "expo": {
    "name": "Saige Fit",
    "slug": "saige-fit",
    "scheme": "saigefit",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Saige Fit uses the camera to scan your meals and barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saige Fit lets you pick meal and progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C6FF3D"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-health-connect",
      "./plugins/withHealthConnectDelegate"
    ],
    "ios": {
      "bundleIdentifier": "com.saigefit.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.saigefit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#7DFF8E",
        "backgroundImage": "./assets/adaptive-bg.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEART_RATE"
      ],
      "versionCode": 2
    },
    "backgroundColor": "#07080A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080A"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#07080A",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png"
  }
}